# Docker Compose settings (compose.yaml). Copy to .env next to it.

# Password of the Postgres database inside the stack.
POSTGRES_PASSWORD=change-me

# The API address browsers and phones use; the web app reads it as it renders a page.
# On a server: https://forza-api.example.com
PUBLIC_API_URL=http://localhost:4000

# Ports on 127.0.0.1 that the reverse proxy forwards to.
API_PORT=4000
WEB_PORT=3000

# Image tag to pull: latest, or the commit SHA CI published.
IMAGE_TAG=latest
