# Copy to .env and adjust. Only DATABASE_URL is required.

# development | production | test
NODE_ENV=development

# HTTP and WebSocket server. 0.0.0.0 lets a phone on the same network connect.
HTTP_HOST=0.0.0.0
HTTP_PORT=4000

# Telemetry from the game. Use 0.0.0.0 when the game runs on another machine or an Xbox.
# Ports 5200-5300 are taken by the game itself.
UDP_HOST=127.0.0.1
UDP_PORT=9876

# udp listens for the game; replay plays REPLAY_FILE in a loop instead (the hosted demo).
TELEMETRY_SOURCE=udp
# REPLAY_FILE=../../recordings/demo.ftr.gz
# Store sessions and laps; turn off for a replay, which would repeat one forever.
# RECORD_SESSIONS=true

# Frames per second sent to live clients (1-60).
LIVE_RATE_HZ=30

# Silence after which the game counts as offline.
TELEMETRY_TIMEOUT_MS=2000

# PostgreSQL for session history. `pnpm --filter @ft/api db:local` serves an embedded one
# (PGlite) at this URL without Docker.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Connections in the pool, 10 by default. PGlite runs one query at a time, so 1 is enough there.
DATABASE_POOL_SIZE=1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs; defaults to true in development and to JSON otherwise.
# LOG_PRETTY=true
